# Public WhatsApp destination used by the order flow.
NEXT_PUBLIC_WHATSAPP_NUMBER=917070080808

# Optional: receive every order JSON payload in n8n / Make / Zapier / your own backend.
ORDER_WEBHOOK_URL=

# Optional shared secret forwarded to your webhook as x-maaro-secret.
ORDER_WEBHOOK_SECRET=

# Optional: show a phone number / mail address in the UI.
NEXT_PUBLIC_STORE_PHONE=+91 70700 80808
NEXT_PUBLIC_STORE_EMAIL=orders@maaro-bihar-clothing.example
